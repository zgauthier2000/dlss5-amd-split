#version 460
// plugin3 (2026-11-21): runtime_reuse_stat.comp for the accumulator with EdgeDrop's sentinels: an invalid texel (|uv| > 8, the
// motion3 sentinel) counts as no motion, as NaN and inf already did; the mean still divides by every texel.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) buffer Stat { float mean_pixels[]; };
layout(set = 0, binding = 1, rg32f) uniform readonly image2D motion;
layout(push_constant) uniform Push {
    uint width, height;       // the field
    float scale_x, scale_y;   // engine units -> uv
    float pixels_x, pixels_y; // the model's extent
    uint word;
} pc;
shared float partial[256];

// plugin6 (2026-11-21, part A trim): the same sum in the same order, its loads issued 16 at a time (one walk of the field
// by one workgroup was latency-bound: ~0.2 ms a dispatch at 2258x1270). Each invocation still adds its texels i, i+256, i+512, ...
// one after another, so the float result is bit for bit the v5 shader's.
float texel_length(uint i) {
    const vec2 u = imageLoad(motion, ivec2(i % pc.width, i / pc.width)).xy * vec2(pc.scale_x, pc.scale_y);
    const vec2 m = u * vec2(pc.pixels_x, pc.pixels_y);
    const float l = length(m);
    return (isnan(l) || isinf(l) || any(greaterThan(abs(u), vec2(8.0)))) ? 0.0 : l;
}

void main() {
    const uint count = pc.width * pc.height;
    float sum = 0.0;
    uint i = gl_LocalInvocationID.x;
    for (; i + 256u * 15u < count; i += 256u * 16u) {
        float v[16];
        for (uint k = 0u; k < 16u; ++k) v[k] = texel_length(i + 256u * k);
        for (uint k = 0u; k < 16u; ++k) sum += v[k];
    }
    for (; i < count; i += 256u) sum += texel_length(i);
    partial[gl_LocalInvocationID.x] = sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (gl_LocalInvocationID.x < s) partial[gl_LocalInvocationID.x] += partial[gl_LocalInvocationID.x + s];
        barrier();
    }
    if (gl_LocalInvocationID.x == 0u) mean_pixels[pc.word] = partial[0] / float(max(count, 1u));
}
